rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /participants/{uid} {
   allow read: if request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID';
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && request.resource.data.keys().hasOnly(['name','subdistrict','date'])
    && request.resource.data.keys().hasAll(['name','subdistrict','date'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
    && request.resource.data.subdistrict is string && request.resource.data.subdistrict.size() > 0 && request.resource.data.subdistrict.size() <= 120
    && request.resource.data.date == request.time;
  }
 }
}
